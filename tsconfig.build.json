{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    // TypeScript 6 writes build info next to the config by default; keep it in dist so prebuild clears it
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}
